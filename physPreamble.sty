\newcommand*{\makeTitlepage}[3]{%
	\renewcommand*{\labNum}{#1}
	\renewcommand*{\labName}{#2}
	\renewcommand*{\dateStart}{#3}
	\makeTitlepageInner
}

\newcommand*{\makeTitlepageOther}[5]{%
	\renewcommand*{\labNum}{#1}
	\renewcommand*{\labName}{#2}
	\renewcommand*{\dateStart}{#3}
	%\newcommand*{\studentCourse}{1}
	\renewcommand*{\studentGroup}{#4}
	\renewcommand*{\studentName}{#5}
	\makeTitlepageInner
}

\newcommand*{\makeTitlepageInner}{%
	\hspace*{\fill}%
	\begin{minipage}{0.33\textwidth}
		\dateStart\\
		\studentName\\
		\studentCourse{} курс, группа \studentGroup\\[1\baselineskip]
		Отметка: \hrulefill\par
	\end  {minipage}
	\vspace{30pt}
	\begin{center}
		\bfseries
		\Large
		Лабораторная работа №~\labNum\\[0.5\baselineskip]
		\large
		<<\labName>>
	\end  {center}
}
	
