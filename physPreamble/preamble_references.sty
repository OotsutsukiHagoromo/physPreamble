\urlstyle{sf}

\RequirePackage[nameinlink, russian]{cleveref}

\renewcommand*{\figureautorefname}{рис.}
\renewcommand*{\tableautorefname}{табл.}
\newcommand*{\picref}[1]{рис.\,\ref{#1}}
\newcommand*{\tabref}[1]{табл.\,\ref{#1}}
\renewcommand*{\picref}[1]{\autoref{#1}}
